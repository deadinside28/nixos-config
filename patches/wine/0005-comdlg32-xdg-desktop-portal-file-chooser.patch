+        p_dbus_message_iter_open_container( &entry, DBUS_TYPE_VARIANT, "a(sa(us))", &variant );
+        p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "(sa(us))", &array );
+        for (name = filters; *name; name += strlen( name ) + 1)
