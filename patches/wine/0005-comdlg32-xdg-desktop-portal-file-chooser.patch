+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &title );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "{sv}", &dict );
+
+    append_variant( &dict, "handle_token", DBUS_TYPE_STRING, "s", &token );
+    append_variant( &dict, "modal", DBUS_TYPE_BOOLEAN, "b", &modal );
+    if (save)
+    {
