+#ifndef __WINE_COMDLG32_UNIXLIB_H
+#define __WINE_COMDLG32_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+#define FILE_CHOOSER_SAVE       0x01
+#define FILE_CHOOSER_MULTIPLE   0x02
+#define FILE_CHOOSER_DIRECTORY  0x04
+
+/* The structure has the same layout for 32-bit and 64-bit callers.
+ *
+ * Input strings are UTF-8 (paths are Unix paths) stored in data at the given
+ * offsets; an offset of ~0u means not set. filters holds "name\0pattern;pattern\0"
+ * pairs, shared_dirs holds null terminated paths; both lists end with an empty
+ * string. shared_dirs are directories inside the prefix that are symlinks to host
+ * directories; picked paths below their targets are returned through the links.
+ *
+ * On success data is overwritten with the picked Unix paths, each null terminated,
+ * followed by an empty string, and filter_index is the filter the user chose. */
+struct file_chooser_params
+{
+    UINT64 parent;          /* X11 window of the owner, 0 if none */
+    UINT32 flags;
+    UINT32 filter_index;
+    UINT32 title;
+    UINT32 current_name;
+    UINT32 current_folder;
+    UINT32 filters;
+    UINT32 shared_dirs;
+    UINT32 size;            /* size of data */
+    char   data[8];
+};
+
+/* Link a host directory the user picked into a directory of the prefix, so that a
+ * prefix without a drive for it can still reach it. data holds the Unix path of
+ * the directory to put links in and the Unix path of the target, both null
+ * terminated. On success data is overwritten with the full Unix path of the link.
+ * An existing link to the same target is reused. */
+struct link_folder_params
+{
+    UINT32 size;            /* size of data */
+    char   data[4096];
+};
+
+enum comdlg32_funcs
+{
+    unix_file_chooser,
+    unix_link_folder,
+    unix_funcs_count
+};
+
+#endif /* __WINE_COMDLG32_UNIXLIB_H */
