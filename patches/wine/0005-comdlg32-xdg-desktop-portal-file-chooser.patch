+    }
+    else
+    {
+        append_variant( &dict, "multiple", DBUS_TYPE_BOOLEAN, "b", &multiple );
+        append_variant( &dict, "directory", DBUS_TYPE_BOOLEAN, "b", &directory );
+    }
+
+    /* show the real directory, not the symlink inside the prefix */
+    if (folder && (path = realpath( folder, NULL )))
+    {
+        const char *ptr = path;
+
+        key = "current_folder";
+        p_dbus_message_iter_open_container( &dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+        p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, &key );
+        p_dbus_message_iter_open_container( &entry, DBUS_TYPE_VARIANT, "ay", &variant );
+        p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "y", &array );
