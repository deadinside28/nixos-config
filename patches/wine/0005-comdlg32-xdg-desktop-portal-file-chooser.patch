+
+/* canonical path; for a file that does not exist yet only the directory is resolved */
+static char *canonicalize( const char *path )
+{
+    const char *slash = strrchr( path, '/' );
+    char *dir, *real, *ret;
+
+    if ((ret = realpath( path, NULL ))) return ret;
+    if (!slash || slash == path) return strdup( path );
+    if (!(dir = strndup( path, slash - path ))) return NULL;
+    real = realpath( dir, NULL );
+    free( dir );
+    if (!real) return strdup( path );
+    if ((ret = malloc( strlen( real ) + strlen( slash ) + 1 )))
+    {
+        strcpy( ret, real );
+        strcat( ret, slash );
+    }
+    free( real );
+    return ret;
+}
+
+/* return a path below a shared directory through its link inside the prefix */
+static char *map_to_shared_dir( char *path, const char *shared_dirs )
+{
+    const char *dir;
+    char *target, *ret;
+    size_t len;
+
+    for (dir = shared_dirs; dir && *dir; dir += strlen( dir ) + 1)
+    {
+        if (!(target = realpath( dir, NULL ))) continue;
+        len = strlen( target );
+        if (len > 1 && !strncmp( path, target, len ) && (!path[len] || path[len] == '/') &&
+            (ret = malloc( strlen( dir ) + strlen( path + len ) + 1 )))
+        {
+            strcpy( ret, dir );
+            strcat( ret, path + len );
+            free( target );
+            free( path );
+            return ret;
+        }
+        free( target );
+    }
+    return path;
+}
+
+static char *uri_to_path( const char *uri )
+{
+    char *ret, *out;
+    const char *p;
+
+    if (strncmp( uri, "file://", 7 )) return NULL;
+    uri += 7;
+    if (*uri != '/' && !(uri = strchr( uri, '/' ))) return NULL;  /* skip host name */
+    if (!(ret = out = malloc( strlen( uri ) + 1 ))) return NULL;
+    for (p = uri; *p; p++)
+    {
+        if (p[0] == '%' && isxdigit( (unsigned char)p[1] ) && isxdigit( (unsigned char)p[2] ))
+        {
+            char hex[3] = { p[1], p[2], 0 };
+            *out++ = strtoul( hex, NULL, 16 );
+            p += 2;
+        }
+        else *out++ = *p;
+    }
+    *out = 0;
+    return ret;
+}
+
+static NTSTATUS parse_response( DBusMessage *msg, struct file_chooser_params *params,
+                                const char *shared_dirs, const char *filters )
+{
+    DBusMessageIter iter, dict, entry, variant, array;
+    dbus_uint32_t response;
+    const char *key, *str;
+    char *result = NULL, *path;
+    size_t len = 0, size;
+    NTSTATUS status;
+
+    if (!p_dbus_message_iter_init( msg, &iter ) || p_dbus_message_iter_get_arg_type( &iter ) != DBUS_TYPE_UINT32)
+        return STATUS_UNSUCCESSFUL;
+    p_dbus_message_iter_get_basic( &iter, &response );
+    TRACE( "response %u\n", response );
+    if (response) return STATUS_CANCELLED;
+
+    p_dbus_message_iter_next( &iter );
+    if (p_dbus_message_iter_get_arg_type( &iter ) != DBUS_TYPE_ARRAY) return STATUS_UNSUCCESSFUL;
+    p_dbus_message_iter_recurse( &iter, &dict );
+    for (; p_dbus_message_iter_get_arg_type( &dict ) == DBUS_TYPE_DICT_ENTRY; p_dbus_message_iter_next( &dict ))
+    {
+        p_dbus_message_iter_recurse( &dict, &entry );
+        p_dbus_message_iter_get_basic( &entry, &key );
+        p_dbus_message_iter_next( &entry );
+        p_dbus_message_iter_recurse( &entry, &variant );
+
+        if (!strcmp( key, "uris" ) && p_dbus_message_iter_get_arg_type( &variant ) == DBUS_TYPE_ARRAY)
+        {
+            p_dbus_message_iter_recurse( &variant, &array );
+            for (; p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_STRING; p_dbus_message_iter_next( &array ))
+            {
+                char *real, *tmp;
+
+                p_dbus_message_iter_get_basic( &array, &str );
+                TRACE( "uri %s\n", debugstr_a(str) );
+                if (!(path = uri_to_path( str ))) continue;
+                real = canonicalize( path );
+                free( path );
+                if (!real) continue;
+                path = map_to_shared_dir( real, shared_dirs );
+                size = strlen( path ) + 1;
+                if ((tmp = realloc( result, len + size + 1 )))
+                {
+                    result = tmp;
+                    memcpy( result + len, path, size );
+                    len += size;
+                }
+                free( path );
+            }
+        }
+        else if (!strcmp( key, "current_filter" ) && filters &&
+                 p_dbus_message_iter_get_arg_type( &variant ) == DBUS_TYPE_STRUCT)
+        {
+            const char *name;
+            UINT32 i;
+
+            p_dbus_message_iter_recurse( &variant, &array );
+            if (p_dbus_message_iter_get_arg_type( &array ) != DBUS_TYPE_STRING) continue;
+            p_dbus_message_iter_get_basic( &array, &str );
+            for (i = 0, name = filters; *name; i++)
+            {
+                if (!strcmp( name, str )) params->filter_index = i;
+                name += strlen( name ) + 1;
+                name += strlen( name ) + 1;
+            }
+        }
+    }
+
+    if (!len) status = STATUS_UNSUCCESSFUL;
+    else if (len + 1 > params->size) status = STATUS_BUFFER_TOO_SMALL;
+    else
+    {
+        memcpy( params->data, result, len );
+        params->data[len] = 0;
+        status = STATUS_SUCCESS;
+    }
+    free( result );
+    return status;
+}
+
+static NTSTATUS file_chooser( void *args )
+{
+    static unsigned int request_id;
+    struct file_chooser_params *params = args;
+    const char *sender, *reply_path = NULL, *str;
+    char *shared_dirs = NULL, *filters = NULL, *handle = NULL, *rule = NULL;
+    char token[64], *p;
+    DBusConnection *conn;
+    DBusMessage *msg, *reply = NULL;
+    DBusError error;
+    NTSTATUS status = STATUS_NOT_SUPPORTED;
+    BOOL done = FALSE;
+    size_t len;
+
+    pthread_once( &dbus_once, load_dbus_functions );
+    if (!dbus_loaded) return STATUS_NOT_SUPPORTED;
+
+    /* keep the input lists, data is overwritten with the result */
+    if ((str = param_str( params, params->shared_dirs )))
+    {
+        for (p = (char *)str; *p; p += strlen( p ) + 1) ;
+        len = p - str + 1;
+        if ((shared_dirs = malloc( len ))) memcpy( shared_dirs, str, len );
+    }
+    if ((str = param_str( params, params->filters )))
+    {
+        for (p = (char *)str; *p; p += strlen( p ) + 1) ;
+        len = p - str + 1;
+        if ((filters = malloc( len ))) memcpy( filters, str, len );
+    }
+
+    p_dbus_error_init( &error );
+    if (!(conn = p_dbus_bus_get_private( DBUS_BUS_SESSION, &error )))
+    {
+        WARN( "failed to connect to the session bus: %s\n", debugstr_a(error.message) );
+        p_dbus_error_free( &error );
+        goto done;
+    }
+    p_dbus_connection_set_exit_on_disconnect( conn, FALSE );
+
+    /* subscribe to the Response signal before making the request, see the
+     * org.freedesktop.portal.Request documentation */
+    snprintf( token, sizeof(token), "wine_comdlg32_%u", __atomic_add_fetch( &request_id, 1, __ATOMIC_SEQ_CST ) );
+    sender = p_dbus_bus_get_unique_name( conn );
+    if (!sender || !(handle = malloc( strlen( sender ) + strlen( token ) + 64 ))) goto done;
+    sprintf( handle, "/org/freedesktop/portal/desktop/request/%s/%s", sender + (*sender == ':'), token );
+    for (p = handle + strlen( "/org/freedesktop/portal/desktop/request/" ); *p != '/'; p++)
+        if (*p == '.') *p = '_';
+    if (!(rule = malloc( strlen( handle ) + 128 ))) goto done;
+    sprintf( rule, "type='signal',interface='org.freedesktop.portal.Request',member='Response',path='%s'", handle );
+    p_dbus_bus_add_match( conn, rule, &error );
+    if (p_dbus_error_is_set( &error ))
+    {
+        WARN( "failed to add match: %s\n", debugstr_a(error.message) );
+        p_dbus_error_free( &error );
+        goto done;
+    }
+
+    if (!(msg = create_request( params, token ))) goto done;
+    reply = p_dbus_connection_send_with_reply_and_block( conn, msg, -1, &error );
+    p_dbus_message_unref( msg );
+    if (!reply)
+    {
+        WARN( "FileChooser request failed: %s\n", debugstr_a(error.message) );
+        p_dbus_error_free( &error );
+        goto done;
+    }
+    if (!p_dbus_message_get_args( reply, &error, DBUS_TYPE_OBJECT_PATH, &reply_path, DBUS_TYPE_INVALID ))
+    {
+        WARN( "unexpected reply: %s\n", debugstr_a(error.message) );
+        p_dbus_error_free( &error );
+        goto done;
+    }
+    TRACE( "request %s\n", debugstr_a(reply_path) );
+    if (strcmp( reply_path, handle ))
+    {
+        /* old portal versions don't use the handle token */
+        free( rule );
+        if (!(rule = malloc( strlen( reply_path ) + 128 ))) goto done;
+        sprintf( rule, "type='signal',interface='org.freedesktop.portal.Request',member='Response',path='%s'",
+                 reply_path );
+        p_dbus_bus_add_match( conn, rule, NULL );
+    }
+
+    status = STATUS_UNSUCCESSFUL;
+    for (;;)
+    {
+        while (!done && (msg = p_dbus_connection_pop_message( conn )))
+        {
+            if (p_dbus_message_is_signal( msg, "org.freedesktop.portal.Request", "Response" ) &&
+                (str = p_dbus_message_get_path( msg )) && (!strcmp( str, handle ) || !strcmp( str, reply_path )))
+            {
+                status = parse_response( msg, params, shared_dirs, filters );
+                done = TRUE;
+            }
+            p_dbus_message_unref( msg );
+        }
+        if (done || !p_dbus_connection_read_write( conn, -1 )) break;
+    }
+
+done:
+    if (reply) p_dbus_message_unref( reply );
+    if (conn)
+    {
+        p_dbus_connection_close( conn );
+        p_dbus_connection_unref( conn );
+    }
+    free( rule );
+    free( handle );
+    free( filters );
+    free( shared_dirs );
+    TRACE( "returning %#x\n", (int)status );
+    return status;
+}
+
+#else  /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS file_chooser( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif  /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS link_folder( void *args )
+{
+    struct link_folder_params *params = args;
+    char *root = NULL, *target = NULL, *link = NULL, current[4096];
+    const char *end = params->data + sizeof(params->data), *base;
+    NTSTATUS status = STATUS_UNSUCCESSFUL;
+    struct stat st;
+    size_t size;
+    ssize_t len;
+    int i;
+
+    if (!(base = memchr( params->data, 0, sizeof(params->data) )) || ++base >= end || !memchr( base, 0, end - base ))
+        return STATUS_INVALID_PARAMETER;
+    if (!(root = strdup( params->data )) || !(target = strdup( base ))) goto done;
+
+    len = strlen( target );
+    while (len > 1 && target[len - 1] == '/') target[--len] = 0;
+    if (stat( target, &st ) || !S_ISDIR( st.st_mode ))
+    {
+        status = STATUS_NOT_A_DIRECTORY;
+        goto done;
+    }
+
+    base = strrchr( target, '/' );
+    base = base && base[1] ? base + 1 : "root";
+    size = strlen( root ) + strlen( base ) + 16;
+    if (!(link = malloc( size ))) goto done;
+
+    for (i = 1; i <= 100; i++)
+    {
+        if (i == 1) snprintf( link, size, "%s/%s", root, base );
+        else snprintf( link, size, "%s/%s (%d)", root, base, i );
+
+        if ((len = readlink( link, current, sizeof(current) - 1 )) >= 0)
+        {
+            current[len] = 0;
+            if (strcmp( current, target )) continue;  /* taken by another folder */
+        }
+        else if (errno != ENOENT || symlink( target, link ))
+        {
+            if (errno == EEXIST) continue;  /* not a symlink, or created meanwhile */
+            WARN( "failed to link %s: %s\n", debugstr_a(link), strerror( errno ) );
+            goto done;
+        }
+        TRACE( "%s -> %s\n", debugstr_a(link), debugstr_a(target) );
+        if (strlen( link ) >= params->size || strlen( link ) >= sizeof(params->data))
+            status = STATUS_BUFFER_TOO_SMALL;
+        else
+        {
+            strcpy( params->data, link );
+            status = STATUS_SUCCESS;
+        }
+        break;
+    }
+
+done:
+    free( link );
+    free( target );
+    free( root );
+    return status;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    file_chooser,
+    link_folder,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+/* the parameter structures have the same layout for 32-bit callers */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    file_chooser,
+    link_folder,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif  /* _WIN64 */
