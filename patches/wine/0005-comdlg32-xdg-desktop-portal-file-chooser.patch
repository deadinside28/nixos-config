+
+static void append_variant( DBusMessageIter *dict, const char *key, int type, const char *sig, const void *value )
+{
+    DBusMessageIter entry, variant;
+
+    p_dbus_message_iter_open_container( dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+    p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, &key );
+    p_dbus_message_iter_open_container( &entry, DBUS_TYPE_VARIANT, sig, &variant );
+    p_dbus_message_iter_append_basic( &variant, type, value );
+    p_dbus_message_iter_close_container( &entry, &variant );
+    p_dbus_message_iter_close_container( dict, &entry );
+}
+
+static void append_glob( DBusMessageIter *patterns, const char *glob )
+{
+    DBusMessageIter pattern;
+    dbus_uint32_t type = 0;
+
+    p_dbus_message_iter_open_container( patterns, DBUS_TYPE_STRUCT, NULL, &pattern );
+    p_dbus_message_iter_append_basic( &pattern, DBUS_TYPE_UINT32, &type );
+    p_dbus_message_iter_append_basic( &pattern, DBUS_TYPE_STRING, &glob );
+    p_dbus_message_iter_close_container( patterns, &pattern );
+}
+
+/* append a (sa(us)) filter built from a Windows "*.a;*.b" pattern list */
+static void append_filter( DBusMessageIter *iter, const char *name, const char *spec )
+{
+    DBusMessageIter filter, patterns;
+    char *copy = strdup( spec ), *glob, *next, *p;
+    BOOL lower, upper;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_STRUCT, NULL, &filter );
+    p_dbus_message_iter_append_basic( &filter, DBUS_TYPE_STRING, &name );
+    p_dbus_message_iter_open_container( &filter, DBUS_TYPE_ARRAY, "(us)", &patterns );
+    for (glob = copy; glob; glob = next)
+    {
+        if ((next = strchr( glob, ';' ))) *next++ = 0;
+        while (*glob == ' ') glob++;
+        for (p = glob + strlen( glob ); p > glob && p[-1] == ' '; p--) p[-1] = 0;
+        if (!*glob) continue;
+        if (!strcmp( glob, "*.*" )) glob[1] = 0;
+        append_glob( &patterns, glob );
+        /* Windows patterns are case insensitive, add upper and lower case variants */
+        for (p = glob, lower = upper = FALSE; *p; p++)
+        {
+            if (islower( (unsigned char)*p )) lower = TRUE;
+            if (isupper( (unsigned char)*p )) upper = TRUE;
+        }
+        if (lower)
+        {
+            for (p = glob; *p; p++) *p = toupper( (unsigned char)*p );
+            append_glob( &patterns, glob );
+        }
+        if (upper)
+        {
+            for (p = glob; *p; p++) *p = tolower( (unsigned char)*p );
+            append_glob( &patterns, glob );
+        }
+    }
+    p_dbus_message_iter_close_container( &filter, &patterns );
+    p_dbus_message_iter_close_container( iter, &filter );
+    free( copy );
+}
