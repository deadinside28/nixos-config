diff --git a/dlls/comdlg32/hostdlg.c b/dlls/comdlg32/hostdlg.c
new file mode 100644
index 0000000..11e529c
--- /dev/null
+++ b/dlls/comdlg32/hostdlg.c
@@ -0,0 +1,443 @@
+/*
+ * Host file chooser (xdg-desktop-portal) for the common file dialogs
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "shlobj.h"
+#include "shlwapi.h"
+#include "commdlg.h"
+#include "cderr.h"
+#include "cdlg.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(commdlg);
+
+#define RESULT_SIZE 0x40000
+
+static BOOL init_unixlib(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    static BOOL loaded;
+    BOOL pending;
+
+    if (InitOnceBeginInitialize(&once, 0, &pending, NULL) && pending)
+    {
+        loaded = !__wine_init_unix_call();
+        InitOnceComplete(&once, 0, NULL);
+    }
+    return loaded;
+}
+
+/* HKCU\Software\Wine\FileDialog "HostFileChooser" = "Y" enables the host file chooser */
+BOOL host_file_chooser_enabled(void)
+{
+    WCHAR value[8];
+    DWORD size = sizeof(value);
+
+    if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Wine\\FileDialog", L"HostFileChooser",
+                     RRF_RT_REG_SZ, NULL, value, &size))
+        return FALSE;
+    return value[0] == 'y' || value[0] == 'Y' || value[0] == 't' || value[0] == 'T' || value[0] == '1';
+}
+
+static UINT32 add_string(struct file_chooser_params *params, UINT32 *pos, const WCHAR *str, BOOL unix_path)
+{
+    UINT32 offset = *pos;
+    char *unix_name;
+    int len;
+
+    if (!str) return ~0u;
+    if (unix_path)
+    {
+        if (!(unix_name = wine_get_unix_file_name(str))) return ~0u;
+        len = strlen(unix_name) + 1;
+        if (offset + len > params->size) len = 0;
+        else memcpy(params->data + offset, unix_name, len);
+        HeapFree(GetProcessHeap(), 0, unix_name);
+    }
+    else len = WideCharToMultiByte(CP_UTF8, 0, str, -1, params->data + offset, params->size - offset, NULL, NULL);
+
+    if (!len) return ~0u;
+    *pos += len;
+    return offset;
+}
+
+/* list of the known folders a sandboxed prefix links to host directories */
+static UINT32 add_shared_dirs(struct file_chooser_params *params, UINT32 *pos)
+{
+    static const KNOWNFOLDERID *folders[] =
+    {
+        &FOLDERID_Desktop, &FOLDERID_Documents, &FOLDERID_Downloads,
+        &FOLDERID_Music, &FOLDERID_Pictures, &FOLDERID_Videos,
+    };
+    UINT32 offset = *pos;
+    WCHAR *path;
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(folders); i++)
+    {
+        if (FAILED(SHGetKnownFolderPath(folders[i], KF_FLAG_DONT_VERIFY, NULL, &path))) continue;
+        add_string(params, pos, path, TRUE);
+        CoTaskMemFree(path);
+    }
+    if (*pos >= params->size) return ~0u;
+    params->data[(*pos)++] = 0;
+    return offset;
+}
+
+static UINT32 add_filters(struct file_chooser_params *params, UINT32 *pos, const WCHAR *filters)
+{
+    UINT32 offset = *pos;
+
+    if (!filters || !*filters) return ~0u;
+    while (*filters && filters[wcslen(filters) + 1])
+    {
+        if (add_string(params, pos, filters, FALSE) == ~0u) return ~0u;
+        filters += wcslen(filters) + 1;
+        if (add_string(params, pos, filters, FALSE) == ~0u) return ~0u;
+        filters += wcslen(filters) + 1;
+    }
+    if (*pos >= params->size) return ~0u;
+    params->data[(*pos)++] = 0;
+    return offset;
+}
+
+static DWORD WINAPI file_chooser_thread(void *params)
+{
+    return WINE_UNIX_CALL(unix_file_chooser, params);
+}
+
+/* run the request on another thread and keep the caller's windows responsive */
+static NTSTATUS run_file_chooser(struct file_chooser_params *params, HWND owner)
+{
+    BOOL enabled = FALSE, quit = FALSE;
+    WPARAM quit_code = 0;
+    HANDLE thread;
+    DWORD status;
+    MSG msg;
+
+    if (!(thread = CreateThread(NULL, 0, file_chooser_thread, params, 0, NULL)))
+        return STATUS_NOT_SUPPORTED;
+
+    if (owner) enabled = !EnableWindow(owner, FALSE);
+    while (MsgWaitForMultipleObjects(1, &thread, FALSE, INFINITE, QS_ALLINPUT) == WAIT_OBJECT_0 + 1)
+    {
+        while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE))
+        {
+            if (msg.message == WM_QUIT)
+            {
+                quit = TRUE;
+                quit_code = msg.wParam;
+                continue;
+            }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    if (enabled)
+    {
+        EnableWindow(owner, TRUE);
+        SetForegroundWindow(owner);
+    }
+    if (quit) PostQuitMessage(quit_code);
+
+    GetExitCodeThread(thread, &status);
+    CloseHandle(thread);
+    return status;
+}
+
+/* Files the prefix can't reach (outside the shared folders, no Z: drive) are
+ * copied to %TEMP%\host-files\<unique>\ so the application can read them. */
+static WCHAR *copy_to_temp(const WCHAR *unix_name, WCHAR *dir)
+{
+    const WCHAR *name = PathFindFileNameW(unix_name);
+    WCHAR *dest;
+
+    if (!dir[0])
+    {
+        static LONG counter;
+        WCHAR temp[MAX_PATH];
+
+        if (!GetTempPathW(ARRAY_SIZE(temp), temp)) return NULL;
+        wcscat(temp, L"host-files");
+        CreateDirectoryW(temp, NULL);
+        swprintf(dir, MAX_PATH, L"%s\\%lx-%lx", temp, GetCurrentProcessId(), InterlockedIncrement(&counter));
+        if (!CreateDirectoryW(dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return NULL;
+    }
+    if (!(dest = HeapAlloc(GetProcessHeap(), 0, (wcslen(dir) + wcslen(name) + 2) * sizeof(WCHAR))))
+        return NULL;
+    swprintf(dest, wcslen(dir) + wcslen(name) + 2, L"%s\\%s", dir, name);
+    TRACE("copying %s to %s\n", debugstr_w(unix_name), debugstr_w(dest));
+    if (!CopyFileW(unix_name, dest, FALSE))
+    {
+        WARN("failed to copy %s: %lu\n", debugstr_w(unix_name), GetLastError());
+        HeapFree(GetProcessHeap(), 0, dest);
+        return NULL;
+    }
+    return dest;
+}
+
+/* A picked Unix path the prefix can't reach (outside the shared folders, no Z:
+ * drive) is made reachable by linking its folder (or the picked folder itself)
+ * into C:\Linux\. The user picked it, so exposing just that folder is fine, and
+ * the link is kept so that remembered paths (e.g. a download folder) stay valid. */
+static WCHAR *link_host_folder(const char *path, BOOL is_dir)
+{
+    struct link_folder_params *params;
+    const char *slash = strrchr(path, '/');
+    char *root, *dir = NULL, *link_path = NULL;
+    WCHAR *ret = NULL;
+    size_t len;
+
+    if (!CreateDirectoryW(L"C:\\Linux", NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return NULL;
+    if (!(root = wine_get_unix_file_name(L"C:\\Linux"))) return NULL;
+    if (!(params = calloc(1, sizeof(*params)))) goto done;
+    params->size = sizeof(params->data);
+
+    if (is_dir) dir = strdup(path);
+    else if (slash && slash != path)
+    {
+        if ((dir = malloc(slash - path + 1)))
+        {
+            memcpy(dir, path, slash - path);
+            dir[slash - path] = 0;
+        }
+    }
+    else dir = strdup("/");
+    if (!dir || strlen(root) + strlen(dir) + 2 > sizeof(params->data)) goto done;
+    strcpy(params->data, root);
+    strcpy(params->data + strlen(root) + 1, dir);
+
+    if (WINE_UNIX_CALL(unix_link_folder, params)) goto done;
+    len = strlen(params->data) + (is_dir ? 0 : strlen(slash)) + 1;
+    if (!(link_path = malloc(len))) goto done;
+    strcpy(link_path, params->data);
+    if (!is_dir) strcat(link_path, slash);
+
+    ret = wine_get_dos_file_name(link_path);
+    TRACE("%s -> %s\n", debugstr_a(path), debugstr_w(ret));
+    if (ret && !wcsncmp(ret, L"\\\\?\\unix\\", 9))
+    {
+        HeapFree(GetProcessHeap(), 0, ret);
+        ret = NULL;
+    }
+
+done:
+    free(link_path);
+    free(dir);
+    free(params);
+    HeapFree(GetProcessHeap(), 0, root);
+    return ret;
+}
+
+/* Show the host file chooser. On success *files receives the picked DOS paths as
+ * a double null terminated list (free with free()). Returns S_OK,
+ * HRESULT_FROM_WIN32(ERROR_CANCELLED), or a failure if Wine's dialog should be
+ * used instead. */
+HRESULT host_file_chooser(struct host_file_chooser *dlg, WCHAR **files)
+{
+    struct file_chooser_params *params;
+    WCHAR temp_dir[MAX_PATH] = L"", *result = NULL, *dos_name, *tmp;
+    UINT32 pos = 0;
+    size_t len = 0, size;
+    HWND owner = NULL;
+    NTSTATUS status;
+    const char *path;
+    HRESULT hr = E_FAIL;
+
+    if (!init_unixlib()) return E_NOTIMPL;
+    if (!(params = calloc(1, sizeof(*params) + RESULT_SIZE))) return E_OUTOFMEMORY;
+    params->size = RESULT_SIZE;
+
+    if (dlg->save) params->flags |= FILE_CHOOSER_SAVE;
+    if (dlg->multiple) params->flags |= FILE_CHOOSER_MULTIPLE;
+    if (dlg->directory) params->flags |= FILE_CHOOSER_DIRECTORY;
+    params->filter_index = dlg->filter_index;
+    params->title = add_string(params, &pos, dlg->title, FALSE);
+    params->current_name = add_string(params, &pos, dlg->file_name, FALSE);
+    params->current_folder = add_string(params, &pos, dlg->folder, TRUE);
+    params->filters = add_filters(params, &pos, dlg->filters);
+    params->shared_dirs = add_shared_dirs(params, &pos);
+    if (dlg->owner && (owner = GetAncestor(dlg->owner, GA_ROOT)))
+        params->parent = (ULONG_PTR)GetPropW(owner, L"__wine_x11_whole_window");
+
+    status = run_file_chooser(params, owner);
+    TRACE("status %#lx\n", status);
+    if (status == STATUS_CANCELLED) hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    if (status) goto done;
+
+    dlg->filter_index = params->filter_index;
+    for (path = params->data; *path; path += strlen(path) + 1)
+    {
+        if (!(dos_name = wine_get_dos_file_name(path))) goto done;
+        TRACE("%s -> %s\n", debugstr_a(path), debugstr_w(dos_name));
+        if (!wcsncmp(dos_name, L"\\\\?\\unix\\", 9))
+        {
+            if (!(tmp = link_host_folder(path, dlg->directory)))
+            {
+                /* last resort for reading; a new file can't be saved to a copy */
+                if (dlg->save || dlg->directory || !(tmp = copy_to_temp(dos_name, temp_dir)))
+                {
+                    HeapFree(GetProcessHeap(), 0, dos_name);
+                    goto done;
+                }
+            }
+            HeapFree(GetProcessHeap(), 0, dos_name);
+            dos_name = tmp;
+        }
+        size = wcslen(dos_name) + 1;
+        if (!(tmp = realloc(result, (len + size + 1) * sizeof(WCHAR))))
+        {
+            HeapFree(GetProcessHeap(), 0, dos_name);
+            goto done;
+        }
+        result = tmp;
+        memcpy(result + len, dos_name, size * sizeof(WCHAR));
+        len += size;
+        result[len] = 0;
+        HeapFree(GetProcessHeap(), 0, dos_name);
+    }
+    if (result)
+    {
+        *files = result;
+        result = NULL;
+        hr = S_OK;
+    }
+
+done:
+    free(result);
+    free(params);
+    return hr;
+}
+
+/* GetOpenFileNameW / GetSaveFileNameW through the host file chooser.
+ * Returns FALSE if Wine's dialog should be used instead. */
+BOOL host_get_file_name(OPENFILENAMEW *ofn, BOOL save, BOOL *ret)
+{
+    struct host_file_chooser dlg = { 0 };
+    WCHAR folder[MAX_PATH], *files, *p, *name;
+    DWORD needed, count, dir_len;
+    HRESULT hr;
+
+    if (!host_file_chooser_enabled()) return FALSE;
+    if (ofn->Flags & (OFN_ENABLEHOOK | OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE)) return FALSE;
+    if ((ofn->Flags & OFN_ALLOWMULTISELECT) && !(ofn->Flags & OFN_EXPLORER)) return FALSE;
+    if (!ofn->lpstrFile || !ofn->nMaxFile) return FALSE;
+
+    dlg.owner = ofn->hwndOwner;
+    dlg.save = save;
+    dlg.multiple = !save && (ofn->Flags & OFN_ALLOWMULTISELECT);
+    dlg.title = ofn->lpstrTitle;
+    dlg.filters = ofn->lpstrFilter;
+    dlg.filter_index = ofn->nFilterIndex ? ofn->nFilterIndex - 1 : 0;
+    dlg.folder = ofn->lpstrInitialDir;
+
+    /* the initial file name may include a directory */
+    folder[0] = 0;
+    if (ofn->lpstrFile[0])
+    {
+        name = PathFindFileNameW(ofn->lpstrFile);
+        if (name != ofn->lpstrFile && name - ofn->lpstrFile < ARRAY_SIZE(folder))
+        {
+            lstrcpynW(folder, ofn->lpstrFile, name - ofn->lpstrFile + 1);
+            if (!dlg.folder) dlg.folder = folder;
+        }
+        if (save && *name) dlg.file_name = name;
+    }
+
+    hr = host_file_chooser(&dlg, &files);
+    if (hr == HRESULT_FROM_WIN32(ERROR_CANCELLED))
+    {
+        COMDLG32_SetCommDlgExtendedError(0);
+        *ret = FALSE;
+        return TRUE;
+    }
+    if (FAILED(hr)) return FALSE;
+
+    if (save && ofn->lpstrDefExt && ofn->lpstrDefExt[0] && !PathFindExtensionW(files)[0])
+    {
+        size_t len = wcslen(files);
+
+        if ((p = realloc(files, (len + wcslen(ofn->lpstrDefExt) + 3) * sizeof(WCHAR))))
+        {
+            files = p;
+            files[len] = '.';
+            wcscpy(files + len + 1, ofn->lpstrDefExt);
+            files[len + wcslen(ofn->lpstrDefExt) + 2] = 0;
+        }
+    }
+
+    for (count = 0, p = files; *p; p += wcslen(p) + 1) count++;
+    name = PathFindFileNameW(files);
+    dir_len = name - files;
+
+    if (count == 1)
+    {
+        needed = wcslen(files) + 1;
+        if (needed > ofn->nMaxFile) goto too_small;
+        wcscpy(ofn->lpstrFile, files);
+        ofn->nFileOffset = dir_len;
+    }
+    else
+    {
+        /* "dir\0name1\0name2\0\0", all files are in the same directory */
+        WCHAR *out = ofn->lpstrFile;
+
+        if (dir_len > 3) dir_len--;  /* keep the backslash only for a drive root */
+        needed = dir_len + 2;
+        for (p = files; *p; p += wcslen(p) + 1) needed += wcslen(PathFindFileNameW(p)) + 1;
+        if (needed > ofn->nMaxFile) goto too_small;
+        memcpy(out, files, dir_len * sizeof(WCHAR));
+        out += dir_len;
+        *out++ = 0;
+        for (p = files; *p; p += wcslen(p) + 1)
+        {
+            wcscpy(out, PathFindFileNameW(p));
+            out += wcslen(out) + 1;
+        }
+        *out = 0;
+        ofn->nFileOffset = dir_len + 1;
+    }
+
+    p = PathFindExtensionW(ofn->lpstrFile + ofn->nFileOffset);
+    ofn->nFileExtension = (count == 1 && *p) ? p - ofn->lpstrFile + 1 : 0;
+    if (ofn->lpstrFileTitle && ofn->nMaxFileTitle)
+        lstrcpynW(ofn->lpstrFileTitle, ofn->lpstrFile + ofn->nFileOffset, ofn->nMaxFileTitle);
+    if (ofn->lpstrFilter) ofn->nFilterIndex = dlg.filter_index + 1;
+
+    free(files);
+    *ret = TRUE;
+    return TRUE;
+
+too_small:
+    TRACE("buffer too small, %lu needed\n", needed);
+    if (ofn->nMaxFile >= 2) *(WORD *)ofn->lpstrFile = needed;
+    COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+    free(files);
+    *ret = FALSE;
+    return TRUE;
+}
diff --git a/dlls/comdlg32/itemdlg.c b/dlls/comdlg32/itemdlg.c
index 830d88b..b95d903 100644
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -2519,13 +2519,117 @@ static ULONG WINAPI IFileDialog2_fnRelease(IFileDialog2 *iface)
     return ref;
 }
 
+/* Use the host file chooser if enabled and the dialog has no custom controls.
+ * Returns S_FALSE if Wine's dialog should be shown instead. */
+static HRESULT show_host_file_chooser(FileDialogImpl *This, HWND owner)
+{
+    struct host_file_chooser dlg = { 0 };
+    WCHAR *filters = NULL, *files = NULL, *folder = NULL, *p;
+    IShellItem *psi_folder;
+    ITEMIDLIST **pidls = NULL;
+    UINT i, count = 0;
+    size_t len = 0;
+    HRESULT hr;
+
+    if (!host_file_chooser_enabled() || !list_empty(&This->cctrls))
+        return S_FALSE;
+
+    for (i = 0; i < This->filterspec_count; i++)
+    {
+        if (!This->filterspecs[i].pszName || !This->filterspecs[i].pszName[0] ||
+            !This->filterspecs[i].pszSpec || !This->filterspecs[i].pszSpec[0])
+            return S_FALSE;
+        len += wcslen(This->filterspecs[i].pszName) + wcslen(This->filterspecs[i].pszSpec) + 2;
+    }
+    if (len && (filters = p = malloc((len + 1) * sizeof(WCHAR))))
+    {
+        for (i = 0; i < This->filterspec_count; i++)
+        {
+            wcscpy(p, This->filterspecs[i].pszName);
+            p += wcslen(p) + 1;
+            wcscpy(p, This->filterspecs[i].pszSpec);
+            p += wcslen(p) + 1;
+        }
+        *p = 0;
+    }
+
+    psi_folder = This->psi_setfolder ? This->psi_setfolder :
+                 This->psi_folder ? This->psi_folder : This->psi_defaultfolder;
+    if (psi_folder && FAILED(IShellItem_GetDisplayName(psi_folder, SIGDN_FILESYSPATH, &folder)))
+        folder = NULL;
+
+    dlg.owner = owner;
+    dlg.save = This->dlg_type == ITEMDLG_TYPE_SAVE;
+    dlg.multiple = !!(This->options & FOS_ALLOWMULTISELECT);
+    dlg.directory = !!(This->options & FOS_PICKFOLDERS);
+    dlg.title = This->custom_title;
+    dlg.filters = filters;
+    dlg.filter_index = This->filetypeindex;
+    dlg.file_name = This->set_filename;
+    dlg.folder = folder;
+
+    hr = host_file_chooser(&dlg, &files);
+    free(filters);
+    CoTaskMemFree(folder);
+    if (hr == HRESULT_FROM_WIN32(ERROR_CANCELLED)) return hr;
+    if (FAILED(hr)) return S_FALSE;
+
+    if (This->filterspec_count)
+        This->filetypeindex = min(dlg.filter_index, This->filterspec_count - 1);
+
+    if (dlg.save && This->default_ext && !PathFindExtensionW(files)[0])
+    {
+        len = wcslen(files);
+        if ((p = realloc(files, (len + wcslen(This->default_ext) + 3) * sizeof(WCHAR))))
+        {
+            files = p;
+            files[len] = '.';
+            wcscpy(files + len + 1, This->default_ext);
+            files[len + wcslen(This->default_ext) + 2] = 0;
+        }
+    }
+
+    for (p = files; *p; p += wcslen(p) + 1) count++;
+    hr = E_OUTOFMEMORY;
+    if ((pidls = calloc(count, sizeof(*pidls))))
+    {
+        for (i = 0, p = files; *p; i++, p += wcslen(p) + 1)
+        {
+            if (FAILED(SHParseDisplayName(p, NULL, &pidls[i], 0, NULL)))
+                pidls[i] = SHSimpleIDListFromPath(p);
+            if (!pidls[i]) break;
+        }
+        if (i == count)
+        {
+            if (This->psia_results)
+            {
+                IShellItemArray_Release(This->psia_results);
+                This->psia_results = NULL;
+            }
+            hr = SHCreateShellItemArrayFromIDLists(count, (PCIDLIST_ABSOLUTE_ARRAY)pidls, &This->psia_results);
+        }
+        for (i = 0; i < count; i++) ILFree(pidls[i]);
+        free(pidls);
+    }
+    free(files);
+    if (FAILED(hr)) return S_FALSE;
+
+    if (events_OnFileOk(This) != S_OK)
+        return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    return S_OK;
+}
+
 static HRESULT WINAPI IFileDialog2_fnShow(IFileDialog2 *iface, HWND hwndOwner)
 {
     FileDialogImpl *This = impl_from_IFileDialog2(iface);
+    HRESULT hr;
     TRACE("%p (%p)\n", iface, hwndOwner);
 
     This->opendropdown_has_selection = FALSE;
 
+    if ((hr = show_host_file_chooser(This, hwndOwner)) != S_FALSE)
+        return hr;
+
     return create_dialog(This, hwndOwner);
 }
 
